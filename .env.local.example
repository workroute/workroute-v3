# Copy this file to .env.local and fill in the two values from your
# Supabase project: Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# §13 — Mobile Message SMS (customer status-change notifications).
# Username/password: mobilemessage.com.au dashboard > Settings > API.
# Sender ID: register it free under Settings > Sender ID first (required by
# the national ACMA Sender ID Register — unregistered senders show as
# "Unverified" to recipients). Max 11 characters, should match your business name.
# No NEXT_PUBLIC_ prefix on purpose — these must stay server-side only, never
# sent to the browser (unlike the Supabase anon key above, which is safe to expose).
MOBILEMESSAGE_USERNAME=your-api-username
MOBILEMESSAGE_PASSWORD=your-api-password
MOBILEMESSAGE_SENDER_ID=YourBizName

# §Messenger — the in-house, white-labeled customer chat (§13's link target)
# and the AI agent that replies in it.
#
# Service role key: Supabase dashboard > Project Settings > API > service_role
# secret key. Already exists in your Supabase project — no new signup. This
# bypasses row-level security entirely, so it's used from exactly one trusted
# server route (see lib/supabase/service-role.ts) and never anywhere else.
# No NEXT_PUBLIC_ prefix — must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Anthropic key: console.anthropic.com > API Keys. Powers the AI that replies
# in Messenger — always in-character as your business, never mentions
# WorkRoute (§23). No NEXT_PUBLIC_ prefix — server-side only.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# §27 — dashboard weather widget. openweathermap.org > API keys. Free tier.
# Paired with the City field on the business profile — plain city name in,
# no geocoding. No NEXT_PUBLIC_ prefix — server-side only. Missing key or
# unset city just means the widget doesn't render, nothing breaks.
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Web Push (VAPID) — customer "new message" notifications, owner high-
# priority + weather-warning notifications. SMS stays the reliable fallback
# either way. Generate a keypair with (after `npm install`):
#   npx web-push generate-vapid-keys
# Public key is safe to expose (NEXT_PUBLIC_ prefix); private key and
# subject stay server-side only. Missing keys just means push silently
# doesn't send — nothing breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Welcome email, sent once per user right after signup email confirmation.
# resend.com > API Keys. RESEND_FROM_EMAIL is optional while testing — Resend's
# own onboarding@resend.dev sender works with no domain setup, just can't
# send to arbitrary addresses until you verify your own sending domain in the
# Resend dashboard. No NEXT_PUBLIC_ prefix — server-side only. Missing key
# just means no welcome email sends, nothing else breaks.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=WorkRoute <onboarding@resend.dev>

# §25 — Phone Voice Intake, via Vapi (vapi.ai), with Claude as the model
# provider. Two separate secrets:
# - VAPI_WEBHOOK_SECRET: a value YOU pick, entered as the "Server URL Secret"
#   on the Vapi phone number/assistant config. Vapi sends it back on every
#   webhook as the x-vapi-secret header — app/api/vapi/webhook/route.ts
#   rejects any request where it doesn't match. This is the one the code
#   here actually checks.
# - VAPI_API_KEY: from the Vapi dashboard (console.vapi.ai > API Keys).
#   Not called by any route yet in this build (number/assistant setup is a
#   manual one-time step in the Vapi dashboard for Phase 1 — see Settings >
#   Phone AI) — kept here for whenever that gets scripted.
# No NEXT_PUBLIC_ prefix on either — server-side only.
VAPI_WEBHOOK_SECRET=
VAPI_API_KEY=

# Optional — overrides the default voice (lib/phone-ai.ts). Currently
# ElevenLabs via Vapi's built-in integration (provider "11labs", voiceId
# "sarah", model "eleven_flash_v2_5") — no separate ElevenLabs account
# needed. Set here to try a different provider/voice/model instead.
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_MODEL=

# §Google Maps — geocoding/address validation and travel-time checks
# (lib/google-maps.ts), the embedded run-sheet map, and now also §39's
# voice completion recap (lib/google-speech.ts uses the same key for Google
# Cloud's Speech-to-Text API — enable "Cloud Speech-to-Text API" on the same
# Google Cloud project, no separate key/account needed).
# Two separate keys from the same Google Cloud project (console.cloud.google.com):
# - GOOGLE_MAPS_API_KEY: server-only, unrestricted. Used for Geocoding API,
#   Distance Matrix API, and Speech-to-Text API. Never sent to the browser.
# - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: deliberately public — ends up in the
#   run-sheet map's iframe src. Restrict it in Google Cloud to your real
#   domain(s) (Application restrictions > Websites) and to "Maps Embed API"
#   only (API restrictions), since anyone can read it from page source.
GOOGLE_MAPS_API_KEY=your-server-only-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-public-maps-embed-api-key

# Secret shared with whatever scheduler triggers the weather-check cron
# (app/api/cron/weather-check) — Vercel Cron once deployed there, any
# external scheduler, or a manual curl during testing. Sent as
# "Authorization: Bearer <value>". Pick any long random string.
CRON_SECRET=a-long-random-string
